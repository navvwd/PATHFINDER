# ---- PathFinder AI configuration ----
# Copy to .env and fill in real values. Never commit .env.
# Comments must be on their own lines (Docker env_file does not strip inline comments).

# development | test | staging | production
ENVIRONMENT=development
DEBUG=false

# PostgreSQL (docker-compose builds DATABASE_URL from these three values)
POSTGRES_DB=pathfinder
POSTGRES_USER=pathfinder
POSTGRES_PASSWORD=change-me-strong-password

# Running the API outside Docker: leave DATABASE_URL unset for the zero-setup SQLite
# fallback, or point it at PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://pathfinder:change-me@localhost:5432/pathfinder

# Redis for shared rate limiting (empty = in-process limiter, fine for one instance)
REDIS_URL=

# JWT signing secret. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Set true when served over HTTPS
COOKIE_SECURE=false

# Comma-separated allowed browser origins (web dev, docker web, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081
FRONTEND_URL=http://localhost:5173

RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_HOUR=30

# AI provider: "anthropic" (Claude via the official SDK) or "none" (deterministic engine only)
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

MAX_UPLOAD_MB=20
DATA_RETENTION_DAYS_AFTER_DELETION=30
CONSENT_REQUIRED_UNDER_AGE=18

# Web (Vite): only needed when the API is on a different origin
# VITE_API_URL=https://api.example.com/api/v1

# Mobile (Expo): your machine's LAN address so a phone can reach the API
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
